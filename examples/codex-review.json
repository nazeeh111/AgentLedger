{
  "version": 1,
  "name": "Opt-in Codex opinion after automated checks",
  "concurrency": 2,
  "tasks": [
    {
      "id": "build",
      "inputs": ["examples/build.mjs"],
      "command": ["node", "examples/build.mjs"],
      "artifacts": [
        {
          "path": "example-output/result.json"
        }
      ]
    },
    {
      "id": "independent",
      "inputs": ["examples/independent.mjs"],
      "command": ["node", "examples/independent.mjs"],
      "artifacts": [
        {
          "path": "example-output/reference.json"
        }
      ]
    },
    {
      "id": "verify",
      "deps": ["build", "independent"],
      "inputs": [
        "examples/verify.mjs",
        "example-output/result.json",
        "example-output/reference.json"
      ],
      "command": ["node", "examples/verify.mjs"]
    },
    {
      "id": "opinion",
      "deps": ["verify"],
      "inputs": ["example-output/result.json"],
      "codex": {
        "prompt": "Read examples/build.mjs, examples/independent.mjs and examples/verify.mjs without changing files. Review whether the independent check supports the generated triangular-number artifact. Return verdict approve, changes, or inconclusive and a concise rationale. Your response is an opinion, not proof."
      }
    },
    {
      "id": "review",
      "deps": ["build", "independent", "verify", "opinion"],
      "review": {
        "checks": ["verify"],
        "artifacts": [
          {
            "task": "build",
            "path": "example-output/result.json"
          },
          {
            "task": "independent",
            "path": "example-output/reference.json"
          }
        ],
        "opinion": "opinion"
      }
    }
  ]
}
